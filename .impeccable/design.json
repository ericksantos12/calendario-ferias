  "narrative": {
    "northStar": "O Planner de Mesa",
    "overview": "Papel limpo, grade precisa, cor só onde há significado. A página se comporta como um planner anual sobre a mesa: fundo frio e claro, cartões brancos de borda fina, e a grade dos meses como protagonista. Nada compete com as datas; a cor existe para marcar períodos e feriados, não para decorar.\n\nDensidade média, coluna única de até 900px. Componentes discretos e precisos: bordas de 1px, cantos suaves, pouco peso tipográfico fora dos títulos. Tema claro e escuro seguem o sistema, com override por data-theme. O que está na tela precisa exportar limpo para PNG, então a hierarquia é feita por cor e peso, nunca por efeitos.",
    "keyCharacteristics": [
      "Grade de meses é o herói; controles ficam acima e recuam visualmente.",
      "Cor semântica: cada período tem sua cor; vermelho é exclusivo de feriado.",
      "Flat: profundidade só por tom (bg → card → field) e borda fina.",
      "Números tabulares em toda data e contagem.",
      "Funciona igual em celular e desktop."
    ],
    "rules": [
      { "name": "The Red Is Holiday Rule", "body": "Vermelho só significa feriado (ou remoção no hover). Nunca use para período, alerta genérico ou ênfase.", "section": "colors" },
      { "name": "The Color Means Period Rule", "body": "Cor saturada na grade sempre corresponde a um período da legenda. Não há cor decorativa.", "section": "colors" },
      { "name": "The Tabular Dates Rule", "body": "Toda data, contagem de dias e ano usa font-variant-numeric: tabular-nums.", "section": "typography" },
      { "name": "The Flat Paper Rule", "body": "Superfícies não flutuam. Separação por tom e fio, nunca por sombra.", "section": "elevation" }
    ],
    "dos": [
      "Do usar tokens --p0…--p5 para períodos, na ordem, e o par dark-* no tema escuro.",
      "Do marcar estados de dia combinando fundo, anel e ponto, para feriado dentro de período continuar legível.",
      "Do manter bordas de 1px line e raios da escala (6/8/10/12px).",
      "Do usar números tabulares em datas e contagens.",
      "Do testar cada mudança visual também no PNG exportado e em 375px."
    ],
    "donts": [
      "Don't usar vermelho para qualquer coisa que não seja feriado ou remoção.",
      "Don't adicionar sombras de elevação, gradientes ou brilhos; o sistema é flat.",
      "Don't introduzir uma terceira família tipográfica.",
      "Don't usar cor decorativa na grade que não corresponda a um item da legenda."
    ]
  }
